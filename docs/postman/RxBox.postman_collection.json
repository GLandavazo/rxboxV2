            },
            "description": "Guarda catalogoPublicId para Obtener, Editar y Activar-desactivar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"METODO_PAGO\",\n  \"nombre\": \"Mercado Pago\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) { pm.environment.set('catalogoPublicId', pm.response.json().publicId); }"
                ]
              }
            }
