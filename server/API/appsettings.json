{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/rxbox-api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "Jwt": {
    "Secret": "", // mínimo 32 bytes — cárgalo por variable de entorno (RXBOX__Jwt__Secret), no lo dejes versionado
    "Issuer": "rxbox-api",
    "Audience": "rxbox-web",
    "SelectionAudience": "rxbox-seleccion-box",
    "AccessMinutos": 15,
    "RefreshDias": 30,
    "SelectionMinutos": 5
  }
}
