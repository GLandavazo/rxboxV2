{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/rxbox-api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rxbox;Username=admin;Password=admin;Include Error Detail=true"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Secret": "FpyfJlgs566qxm3ax3fveWDtmw1pJHmMj6Ybyp4ahOe"
  },
  "Seed": {
    "AdminEmail": "admin@rxbox.local",
    "AdminPassword": "Admin-Dev-RxBox-1"
  }
}